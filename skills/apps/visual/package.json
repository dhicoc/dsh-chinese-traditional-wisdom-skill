{
  "name": "chinese-traditional-wisdom-visual",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "predev": "node scripts/generate-dream-shards.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-dream-shards.mjs",
    "build": "tsc -b && vite build && node scripts/generate-verify-page.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node scripts/smoke-react-shell.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "verify:gen": "node scripts/generate-verify-page.mjs",
    "engine": "tsx scripts/run-engine.ts",
    "engine:list": "tsx scripts/run-engine-agent.ts list",
    "engine:describe": "tsx scripts/run-engine-agent.ts describe",
    "engine:verify": "tsx scripts/run-engine-agent.ts verify",
    "engine:present": "tsx scripts/run-engine-agent.ts present",
    "engine:bundle": "tsx scripts/run-engine-agent.ts bundle",
    "engine:bundle:verify": "tsx scripts/run-engine-agent.ts verify-bundle",
    "knowledge:manifest": "node scripts/generate-knowledge-manifest.mjs",
    "check:knowledge-provenance": "node scripts/generate-knowledge-manifest.mjs --check && node scripts/check-knowledge-provenance.mjs",
    "knowledge:index": "node scripts/generate-knowledge-search-index.mjs",
    "check:knowledge-index": "node scripts/generate-knowledge-search-index.mjs --check",
    "data:char-shards": "node scripts/generate-char-meaning-shards.mjs",
    "check:char-shards": "node scripts/generate-char-meaning-shards.mjs --check",
    "data:dream-shards": "node scripts/generate-dream-shards.mjs",
    "check:dream-shards": "node scripts/generate-dream-shards.mjs --check",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "engine:bazi-time-sensitivity": "tsx scripts/run-engine-agent.ts bazi-time-sensitivity",
    "engine:compare-rules": "tsx scripts/run-engine-agent.ts compare-rules",
    "engine:iching-lookup": "tsx scripts/run-engine-agent.ts iching-lookup",
    "engine:plan": "tsx scripts/run-engine-agent.ts plan",
    "eval:skill": "tsx ../../skill-evals/run-evals.ts",
    "check:release": "node scripts/check-release-contract.mjs"
  },
  "dependencies": {
    "3meta": "2.6.0",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "iztro": "2.5.8",
    "lunar-typescript": "1.8.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "10.5.4",
    "jsdom": "29.1.1",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
