{
  "name": "chinese-traditional-wisdom-visual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-verify-page.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node scripts/smoke-react-shell.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "verify:gen": "node scripts/generate-verify-page.mjs",
    "engine": "tsx scripts/run-engine.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@vitejs/plugin-react": "6.0.5",
    "3meta": "2.6.0",
    "autoprefixer": "10.5.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "iztro": "2.5.8",
    "lunar-typescript": "1.8.6",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "29.1.1",
    "tsx": "4.23.11",
    "vitest": "4.1.10"
  }
